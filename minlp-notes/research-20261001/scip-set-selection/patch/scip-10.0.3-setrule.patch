+/*
+ * Free direction lambda (patch "setrule"): the maximal S-free sets of Chmiela, Munoz and Serrano are
+ * C_lambda = { s : phi_lambda(yhat(s)) <= lambda^T xhat(s) } with a unit vector lambda; SCIP uses
+ * lambda = xhat(zlp) / ||xhat(zlp)||.  Every unit lambda with zlp in the interior of C_lambda gives an S-free set
+ * (Munoz and Serrano 2022, Theorem 2 and Proposition 5).  The functions below compute the restriction of C_lambda
+ * to a ray for an arbitrary unit lambda.  Coordinates (as in computeRestrictionToRay):
+ *   x_k(s) = sqrt(eig_k) (v_k^T s + v_k^T b / (2 eig_k)) for eig_k > 0 (sidefactor applied), in the order of the
+ *   eigenvalues; case 2 appends sqrt(kappa); case 4 appends (w(s) + kappa + r) / (2 sqrt(r)), r = sqrt(1 + kappa^2),
+ *   and yhat appends (w(s) + kappa - r) / (2 sqrt(r)).  lambda has npos (+1 in cases 2 and 4) entries.
+ */
+
+/** number of positive eigenvalues (after applying sidefactor) that the intersection cut code uses */
+static
+int countPositiveEigenvalues(
+   SCIP*                 scip,               /**< SCIP data structure */
+   SCIP_NLHDLREXPRDATA*  nlhdlrexprdata,     /**< nlhdlr expression data */
+   SCIP_Real             sidefactor          /**< 1.0 if the violated constraint is q &le; rhs, -1.0 otherwise */
+   )
+{
+   SCIP_Real* eigenvalues;
+   int nquadexprs;
+   int npos;
+   int i;
+
+   SCIPexprGetQuadraticData(nlhdlrexprdata->qexpr, NULL, NULL, NULL, NULL, &nquadexprs, NULL, &eigenvalues, NULL);
+
+   npos = 0;
+   for( i = 0; i < nquadexprs; ++i )
+      if( ! SCIPisZero(scip, eigenvalues[i]) && sidefactor * eigenvalues[i] > 0.0 )
+         ++npos;
+
+   return npos;
+}
+
+/** computes xhat(zlp) restricted to the positive coordinates: x0[k] = sqrt(eig_k) dot_k */
+static
+void computeLambdaX0(
+   SCIP*                 scip,               /**< SCIP data structure */
+   SCIP_NLHDLREXPRDATA*  nlhdlrexprdata,     /**< nlhdlr expression data */
+   SCIP_Real             sidefactor,         /**< 1.0 if the violated constraint is q &le; rhs, -1.0 otherwise */
+   SCIP_Real*            vb,                 /**< array containing v_i^T b */
+   SCIP_Real*            vzlp,               /**< array containing v_i^T zlp_q */
+   SCIP_Real*            x0                  /**< buffer of length npos */
+   )
+{
+   SCIP_Real* eigenvalues;
+   int nquadexprs;
+   int k;
+   int i;
+
+   SCIPexprGetQuadraticData(nlhdlrexprdata->qexpr, NULL, NULL, NULL, NULL, &nquadexprs, NULL, &eigenvalues, NULL);
+
+   k = 0;
+   for( i = 0; i < nquadexprs; ++i )
+   {
+      SCIP_Real eig;
+
+      if( SCIPisZero(scip, eigenvalues[i]) )
+         continue;
+      eig = sidefactor * eigenvalues[i];
+      if( eig > 0.0 )
+      {
+         x0[k] = sqrt(eig) * (vzlp[i] + vb[i] / (2.0 * eig));
+         ++k;
+      }
+   }
+}
+
+/** computes the lambda-independent data of a ray: ||y(zlp + t ray)||^2 = yA t^2 + yB t + yC, xr = x(ray) in the
+ *  positive coordinates (without the constant shift), and w(ray) (case 4)
+ */
+static
+void computeLambdaRayData(
+   SCIP*                 scip,               /**< SCIP data structure */
+   SCIP_NLHDLREXPRDATA*  nlhdlrexprdata,     /**< nlhdlr expression data */
+   SCIP_Real             sidefactor,         /**< 1.0 if the violated constraint is q &le; rhs, -1.0 otherwise */
+   SCIP_Bool             iscase4,            /**< whether we are in case 4 */
+   SCIP_Real*            raycoefs,           /**< coefficients of ray */
+   int*                  rayidx,             /**< index of consvar the ray coef is associated to */
+   int                   raynnonz,           /**< length of raycoefs and rayidx */
+   SCIP_Real*            vb,                 /**< array containing v_i^T b */
+   SCIP_Real*            vzlp,               /**< array containing v_i^T zlp_q */
+   SCIP_Real*            wcoefs,             /**< coefficients of w for the quad vars or NULL if w is 0 */
+   SCIP_Real*            ya,                 /**< pointer to store yA */
+   SCIP_Real*            yb,                 /**< pointer to store yB */
+   SCIP_Real*            yc,                 /**< pointer to store yC */
+   SCIP_Real*            xr,                 /**< buffer of length npos to store x(ray) */
+   SCIP_Real*            wray                /**< pointer to store w(ray) */
+   )
+{
+   SCIP_Real* eigenvectors;
+   SCIP_Real* eigenvalues;
+   int nquadexprs;
+   int k;
+   int i;
+
+   SCIPexprGetQuadraticData(nlhdlrexprdata->qexpr, NULL, NULL, NULL, NULL, &nquadexprs, NULL, &eigenvalues, &eigenvectors);
+
+   *ya = 0.0;
+   *yb = 0.0;
+   *yc = 0.0;
+   *wray = 0.0;
+   k = 0;
+   for( i = 0; i < nquadexprs; ++i )
+   {
+      SCIP_Real vdotray;
+      SCIP_Real dot;
+      SCIP_Real eig;
+
+      if( SCIPisZero(scip, eigenvalues[i]) )
+      {
+         if( wcoefs == NULL )
+            continue;
+         vdotray = computeEigenvecDotRay(&eigenvectors[i * nquadexprs], nquadexprs, raycoefs, rayidx, raynnonz);
+         *wray += vb[i] * vdotray;
+         continue;
+      }
+
+      eig = sidefactor * eigenvalues[i];
+      dot = vzlp[i] + vb[i] / (2.0 * eig);
+      vdotray = computeEigenvecDotRay(&eigenvectors[i * nquadexprs], nquadexprs, raycoefs, rayidx, raynnonz);
+
+      if( eig > 0.0 )
+      {
+         xr[k] = sqrt(eig) * vdotray;
+         ++k;
+      }
+      else
+      {
+         *ya -= eig * SQR(vdotray);
+         *yb -= 2.0 * eig * dot * vdotray;
+         *yc -= eig * SQR(dot);
+      }
+   }
+
+   if( iscase4 )
+      *wray += computeWRayLinear(nlhdlrexprdata, sidefactor, raycoefs, rayidx, raynnonz);
+}
+
+/** builds A, B, C, D, E (and case-4 data) of the restriction of C_lambda to a ray from the lambda-independent data */
+static
+void buildLambdaCoefs(
+   SCIP_Bool             iscase4,            /**< whether we are in case 4 */
+   SCIP_Real             kappa,              /**< value of kappa */
+   SCIP_Real             wzlp,               /**< value of w at zlp */
+   int                   npos,               /**< number of positive eigenvalues */
+   const SCIP_Real*      lambda,             /**< unit vector lambda (npos entries, +1 in cases 2 and 4) */
+   const SCIP_Real*      x0,                 /**< x(zlp) in the positive coordinates */
+   SCIP_Real             ya,                 /**< yA of the ray */
+   SCIP_Real             yb,                 /**< yB of the ray */
+   SCIP_Real             yc,                 /**< yC of the ray */
+   const SCIP_Real*      xr,                 /**< x(ray) in the positive coordinates */
+   SCIP_Real             wray,               /**< w(ray) */
+   SCIP_Real*            coefs1234a,         /**< buffer to store A, B, C, D, E of cases 1, 2, 3, or 4a */
+   SCIP_Real*            coefs4b,            /**< buffer to store A, B, C, D, E of case 4b (case 4 only) */
+   SCIP_Real*            coefscondition      /**< buffer to store the data of the case-4a condition (case 4 only) */
+   )
+{
+   SCIP_Real dx;
+   SCIP_Real ex;
+   int k;
+
+   dx = 0.0;
+   ex = 0.0;
+   for( k = 0; k < npos; ++k )
+   {
+      dx += lambda[k] * xr[k];
+      ex += lambda[k] * x0[k];
+   }
+
+   if( ! iscase4 )
+   {
+      coefs1234a[0] = ya;
+      coefs1234a[1] = yb;
+      coefs1234a[2] = yc;
+      if( kappa > 0.0 )
+         ex += lambda[npos] * sqrt(kappa);
+      else if( kappa < 0.0 )
+         coefs1234a[2] -= kappa;
+      coefs1234a[3] = dx;
+      coefs1234a[4] = ex;
+   }
+   else
+   {
+      SCIP_Real r;
+      SCIP_Real sr;
+      SCIP_Real xextra;
+      SCIP_Real yextra;
+      SCIP_Real ll;
+      SCIP_Real fac;
+
+      r = sqrt(1.0 + SQR(kappa));
+      sr = sqrt(r);
+      xextra = wzlp + kappa + r;
+      yextra = wzlp + kappa - r;
+      ll = lambda[npos];
+      fac = MAX(1.0 - SQR(ll), 0.0);
+
+      /* piece a: ||yhat(t)|| - lambda^T xhat(t) */
+      coefs1234a[0] = ya + SQR(wray) / (4.0 * r);
+      coefs1234a[1] = yb + 2.0 * yextra * wray / (4.0 * r);
+      coefs1234a[2] = yc + SQR(yextra) / (4.0 * r);
+      coefs1234a[3] = dx + ll * wray / (2.0 * sr);
+      coefs1234a[4] = ex + ll * xextra / (2.0 * sr);
+
+      /* piece b: sqrt((1 - ll^2) ||y(t)||^2) - (lambda^T xhat(t) - ll yhat_last(t)); xhat_last - yhat_last = sqrt(r) */
+      coefs4b[0] = fac * ya;
+      coefs4b[1] = fac * yb;
+      coefs4b[2] = fac * yc;
+      coefs4b[3] = dx;
+      coefs4b[4] = ex + ll * sr;
+
+      /* condition of piece a: -ll ||yhat(t)|| + yhat_last(t) <= 0, multiplied by 2 sqrt(r) */
+      coefscondition[0] = -2.0 * sr * ll;
+      coefscondition[1] = wray;
+      coefscondition[2] = yextra;
+   }
+}
