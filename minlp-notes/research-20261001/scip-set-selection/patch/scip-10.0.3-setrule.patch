+/** data for evaluating C_lambda on all rays of the current cone */
+typedef struct
+{
+   int                   nrays;              /**< number of rays */
+   int                   npos;               /**< number of positive eigenvalues */
+   int                   dim;                /**< dimension of lambda (npos, +1 in cases 2 and 4) */
+   SCIP_Bool             iscase4;            /**< whether we are in case 4 */
+   SCIP_Real             kappa;              /**< kappa */
+   SCIP_Real             wzlp;               /**< w(zlp) */
+   SCIP_Real             sr;                 /**< sqrt(sqrt(1 + kappa^2)) (case 4) */
+   SCIP_Real*            x0;                 /**< xhat(zlp), dim entries */
+   SCIP_Real*            ya;                 /**< yA of each ray */
+   SCIP_Real*            yb;                 /**< yB of each ray */
+   SCIP_Real*            yc;                 /**< yC of each ray */
+   SCIP_Real*            wray;               /**< w(ray) of each ray */
+   SCIP_Real*            xr;                 /**< xhat(ray) - xhat(0) of each ray, dim entries per ray */
+   SCIP_Real*            weight;             /**< floored reduced cost of each ray (rule 1) */
+   SCIP_Real*            rawweight;          /**< reduced cost (absolute value) of each ray */
+   int*                  ubeg;               /**< start of the structural vector of each ray (rule 2) */
+   int*                  uidx;               /**< LP column positions of the structural vectors */
+   SCIP_Real*            uval;               /**< values of the structural vectors */
+   SCIP_Real*            dense;              /**< dense work array over LP columns */
+   SCIP_Real*            alpha;              /**< step lengths of the last evaluation */
+   int                   rule;               /**< 1 = corner bound, 2 = efficacy */
+   int                   nevals;             /**< number of evaluations so far */
+} LAMBDASEARCH;
+
+/** checks numerics of restricted coefficients like areCoefsNumericsGood, but without statistics */
+static
+SCIP_Bool lambdaCoefsGood(
+   SCIP*                 scip,               /**< SCIP data structure */
+   SCIP_NLHDLRDATA*      nlhdlrdata,         /**< nlhdlr data */
+   SCIP_Real*            coefs1234a,         /**< coefficients for case 1-3 and 4a */
+   SCIP_Real*            coefs4b,            /**< coefficients for case 4b */
+   SCIP_Bool             iscase4             /**< whether we are in case 4 */
+   )
+{
+   int piece;
+
+   if( coefs1234a[2] < 0.0 || sqrt(coefs1234a[2]) - coefs1234a[4] >= 0.0 )
+      return FALSE;
+
+   if( ! nlhdlrdata->ignorebadrayrestriction )
+      return TRUE;
+
+   for( piece = 0; piece < (iscase4 ? 2 : 1); ++piece )
+   {
+      SCIP_Real* cf = piece == 0 ? coefs1234a : coefs4b;
+      SCIP_Real max = 0.0;
+      SCIP_Real min = SCIPinfinity(scip);
+      int j;
+
+      for( j = 0; j < 3; ++j )
+      {
+         SCIP_Real absval = REALABS(cf[j]);
+         if( max < absval )
+            max = absval;
+         if( absval != 0.0 && absval < min )
+            min = absval;
+      }
+      if( SCIPisHugeValue(scip, max / min) )
+         return FALSE;
+   }
+
+   return TRUE;
+}
