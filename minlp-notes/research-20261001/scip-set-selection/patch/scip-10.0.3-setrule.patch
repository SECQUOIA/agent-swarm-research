+/** evaluates the criterion of the rule for a unit lambda; returns -infinity if lambda is not usable */
+static
+SCIP_Real evalLambda(
+   SCIP*                 scip,               /**< SCIP data structure */
+   SCIP_NLHDLRDATA*      nlhdlrdata,         /**< nlhdlr data */
+   LAMBDASEARCH*         ls,                 /**< search data */
+   const SCIP_Real*      lambda              /**< unit vector */
+   )
+{
+   SCIP_Real crit;
+   int j;
+
+   ls->nevals++;
+
+   for( j = 0; j < ls->nrays; ++j )
+   {
+      SCIP_Real ca[5];
+      SCIP_Real cb[5];
+      SCIP_Real cc[3];
+
+      buildLambdaCoefs(ls->iscase4, ls->kappa, ls->wzlp, ls->npos, lambda, ls->x0, ls->ya[j], ls->yb[j], ls->yc[j],
+         &ls->xr[j * ls->dim], ls->wray[j], ca, cb, cc);
+
+      if( ! lambdaCoefsGood(scip, nlhdlrdata, ca, cb, ls->iscase4) )
+         return -SCIPinfinity(scip);
+
+      ls->alpha[j] = computeIntersectionPoint(scip, nlhdlrdata, ls->iscase4, ca, cb, cc);
+      if( ls->alpha[j] <= 0.0 )
+         return -SCIPinfinity(scip);
+   }
+
+   if( ls->rule == 1 )
+   {
+      crit = SCIPinfinity(scip);
+      for( j = 0; j < ls->nrays; ++j )
+         if( ! SCIPisInfinity(scip, ls->alpha[j]) )
+            crit = MIN(crit, ls->weight[j] * ls->alpha[j]);
+   }
+   else
+   {
+      SCIP_Real norm2 = 0.0;
+      int k;
+
+      for( j = 0; j < ls->nrays; ++j )
+      {
+         SCIP_Real coef;
+
+         if( SCIPisInfinity(scip, ls->alpha[j]) )
+            continue;
+         coef = 1.0 / ls->alpha[j];
+         for( k = ls->ubeg[j]; k < ls->ubeg[j + 1]; ++k )
+            ls->dense[ls->uidx[k]] += coef * ls->uval[k];
+      }
+      for( j = 0; j < ls->nrays; ++j )
+         for( k = ls->ubeg[j]; k < ls->ubeg[j + 1]; ++k )
+         {
+            norm2 += SQR(ls->dense[ls->uidx[k]]);
+            ls->dense[ls->uidx[k]] = 0.0;
+         }
+      crit = norm2 > 0.0 ? 1.0 / sqrt(norm2) : SCIPinfinity(scip);
+   }
+
+   return crit;
+}
+
+/** derivative of the step length of ray j with respect to lambda (projected onto the tangent space of the sphere) */
+static
+SCIP_Bool alphaGradient(
+   SCIP*                 scip,               /**< SCIP data structure */
+   LAMBDASEARCH*         ls,                 /**< search data */
+   const SCIP_Real*      lambda,             /**< unit vector */
+   int                   j,                  /**< ray */
+   SCIP_Real             t,                  /**< step length of ray j for lambda (finite) */
+   SCIP_Real*            grad                /**< buffer of length dim */
+   )
+{
+   SCIP_Real ca[5];
+   SCIP_Real cb[5];
+   SCIP_Real cc[3];
+   SCIP_Real rad;
+   SCIP_Real dgdt;
+   SCIP_Real proj;
+   int k;
+
+   buildLambdaCoefs(ls->iscase4, ls->kappa, ls->wzlp, ls->npos, lambda, ls->x0, ls->ya[j], ls->yb[j], ls->yc[j],
+      &ls->xr[j * ls->dim], ls->wray[j], ca, cb, cc);
+
+   if( ! ls->iscase4 || isCase4a(t, ca, cc) )
+   {
+      rad = ca[0] * t * t + ca[1] * t + ca[2];
+      if( rad <= 0.0 )
+         return FALSE;
+      dgdt = (2.0 * ca[0] * t + ca[1]) / (2.0 * sqrt(rad)) - ca[3];
+      if( dgdt <= 1e-12 * (1.0 + REALABS(ca[3])) )
+         return FALSE;
+      /* dg/dlambda = -xhat(t) */
+      for( k = 0; k < ls->dim; ++k )
+         grad[k] = (ls->x0[k] + t * ls->xr[j * ls->dim + k]) / dgdt;
+   }
+   else
+   {
+      SCIP_Real ll = lambda[ls->npos];
+      SCIP_Real fac = 1.0 - SQR(ll);
+      SCIP_Real ynorm;
+
+      rad = cb[0] * t * t + cb[1] * t + cb[2];
+      if( rad <= 0.0 )
+         return FALSE;
+      dgdt = (2.0 * cb[0] * t + cb[1]) / (2.0 * sqrt(rad)) - cb[3];
+      if( dgdt <= 1e-12 * (1.0 + REALABS(cb[3])) )
+         return FALSE;
+      for( k = 0; k < ls->npos; ++k )
+         grad[k] = (ls->x0[k] + t * ls->xr[j * ls->dim + k]) / dgdt;
+      ynorm = sqrt(MAX(ls->ya[j] * t * t + ls->yb[j] * t + ls->yc[j], 0.0));
+      grad[ls->npos] = -((fac > 1e-12 ? -ll * ynorm / sqrt(fac) : 0.0) - ls->sr) / dgdt;
+   }
+
+   proj = 0.0;
+   for( k = 0; k < ls->dim; ++k )
+      proj += grad[k] * lambda[k];
+   for( k = 0; k < ls->dim; ++k )
+      grad[k] -= proj * lambda[k];
+
+   return TRUE;
+}
+
+/** lambda(theta) = cos(theta) base + sin(theta) dir, normalized */
+static
+void rotateLambda(
+   int                   dim,                /**< dimension */
+   const SCIP_Real*      base,               /**< unit vector */
+   const SCIP_Real*      dir,                /**< unit vector orthogonal to base */
+   SCIP_Real             theta,              /**< angle */
+   SCIP_Real*            out                 /**< buffer */
+   )
+{
+   SCIP_Real norm = 0.0;
+   int k;
+
+   for( k = 0; k < dim; ++k )
+   {
+      out[k] = cos(theta) * base[k] + sin(theta) * dir[k];
+      norm += SQR(out[k]);
+   }
+   norm = sqrt(norm);
+   for( k = 0; k < dim; ++k )
+      out[k] /= norm;
+}
+
+/** golden-section maximization of the criterion over theta in [lo, hi] along a great circle */
+static
+void goldenSearch(
+   SCIP*                 scip,               /**< SCIP data structure */
+   SCIP_NLHDLRDATA*      nlhdlrdata,         /**< nlhdlr data */
+   LAMBDASEARCH*         ls,                 /**< search data */
+   const SCIP_Real*      base,               /**< base point */
+   const SCIP_Real*      dir,                /**< direction */
+   SCIP_Real             lo,                 /**< lower end */
+   SCIP_Real             hi,                 /**< upper end */
+   int                   maxevals,           /**< evaluations allowed */
+   SCIP_Real*            work,               /**< work buffer of length dim */
+   SCIP_Real*            bestlambda,         /**< best lambda so far (updated) */
+   SCIP_Real*            bestcrit            /**< best criterion so far (updated) */
+   )
+{
+   const SCIP_Real gr = 0.6180339887498949;
+   SCIP_Real m1;
+   SCIP_Real m2;
+   SCIP_Real f1;
+   SCIP_Real f2;
+   int n;
+
+   if( maxevals < 2 )
+      return;
+
+   m1 = hi - gr * (hi - lo);
+   m2 = lo + gr * (hi - lo);
+   rotateLambda(ls->dim, base, dir, m1, work);
+   f1 = evalLambda(scip, nlhdlrdata, ls, work);
+   if( f1 > *bestcrit )
+   {
+      *bestcrit = f1;
+      BMScopyMemoryArray(bestlambda, work, ls->dim);
+   }
+   rotateLambda(ls->dim, base, dir, m2, work);
+   f2 = evalLambda(scip, nlhdlrdata, ls, work);
+   if( f2 > *bestcrit )
+   {
+      *bestcrit = f2;
+      BMScopyMemoryArray(bestlambda, work, ls->dim);
+   }
+
+   for( n = 2; n < maxevals; ++n )
+   {
+      if( f1 >= f2 )
+      {
+         hi = m2;
+         m2 = m1;
+         f2 = f1;
+         m1 = hi - gr * (hi - lo);
+         rotateLambda(ls->dim, base, dir, m1, work);
+         f1 = evalLambda(scip, nlhdlrdata, ls, work);
+         if( f1 > *bestcrit )
+         {
+            *bestcrit = f1;
+            BMScopyMemoryArray(bestlambda, work, ls->dim);
+         }
+      }
+      else
+      {
+         lo = m1;
+         m1 = m2;
+         f1 = f2;
+         m2 = lo + gr * (hi - lo);
+         rotateLambda(ls->dim, base, dir, m2, work);
+         f2 = evalLambda(scip, nlhdlrdata, ls, work);
+         if( f2 > *bestcrit )
+         {
+            *bestcrit = f2;
+            BMScopyMemoryArray(bestlambda, work, ls->dim);
+         }
+      }
+   }
+}
+
+/** writes the corner data of the current cut to the dump file (one JSON object per line) */
+static
+void dumpCorner(
+   SCIP*                 scip,               /**< SCIP data structure */
+   SCIP_NLHDLRDATA*      nlhdlrdata,         /**< nlhdlr data */
+   SCIP_NLHDLREXPRDATA*  nlhdlrexprdata,     /**< nlhdlr expression data */
+   RAYS*                 rays,               /**< rays */
+   SCIP_VAR*             auxvar,             /**< aux var or NULL */
+   SCIP_SOL*             sol,                /**< solution */
+   SCIP_Real             sidefactor,         /**< sidefactor */
+   LAMBDASEARCH*         ls,                 /**< search data */
+   const SCIP_Real*      lambda0,            /**< SCIP's lambda */
+   const SCIP_Real*      alpha0,             /**< step lengths for SCIP's lambda (from evalLambda) */
+   SCIP_Real             crit0,              /**< criterion of SCIP's lambda */
+   const SCIP_Real*      lambdabest,         /**< chosen lambda */
+   const SCIP_Real*      alphabest,          /**< step lengths for the chosen lambda */
+   SCIP_Real             critbest,           /**< criterion of the chosen lambda */
+   SCIP_Bool             changed             /**< whether the chosen lambda is used */
+   )
+{
+   FILE* f;
+   SCIP_EXPR* qexpr;
+   SCIP_EXPR** linexprs;
+   SCIP_Real* lincoefs;
+   SCIP_Real* eigenvalues;
+   SCIP_Real* eigenvectors;
+   SCIP_Real constant;
+   int nlinexprs;
+   int nquadexprs;
+   int nbilin;
+   int nconsvars;
+   int i;
+   int j;
+
+   f = fopen(nlhdlrdata->dumpfile, "a");
+   if( f == NULL )
+      return;
+
+   qexpr = nlhdlrexprdata->qexpr;
+   SCIPexprGetQuadraticData(qexpr, &constant, &nlinexprs, &linexprs, &lincoefs, &nquadexprs, &nbilin, &eigenvalues,
+      &eigenvectors);
+   nconsvars = nquadexprs + nlinexprs + (auxvar != NULL ? 1 : 0);
+
+   if( nlhdlrexprdata->cons != NULL && auxvar == NULL )
+      constant = (sidefactor == 1.0) ? constant - SCIPgetRhsNonlinear(nlhdlrexprdata->cons) :
+         SCIPgetLhsNonlinear(nlhdlrexprdata->cons) - constant;
+   else
+      constant = sidefactor * constant;
+
+   fprintf(f, "{\"type\":\"corner\",\"nlps\":%" SCIP_LONGINT_FORMAT ",\"node\":%" SCIP_LONGINT_FORMAT ",\"depth\":%d,"
+      "\"rule\":%d,\"iscase4\":%d,\"kappa\":%.17g,\"wzlp\":%.17g,\"sf\":%.17g,\"nquad\":%d,\"nlin\":%d,\"aux\":%d,"
+      "\"constant\":%.17g,\"changed\":%d,\"crit0\":%.17g,\"critbest\":%.17g,\"npos\":%d,\"dim\":%d",
+      SCIPgetNLPs(scip), SCIPnodeGetNumber(SCIPgetCurrentNode(scip)), SCIPgetDepth(scip), ls->rule, ls->iscase4,
+      ls->kappa, ls->wzlp, sidefactor, nquadexprs, nlinexprs, auxvar != NULL ? 1 : 0, constant, changed, crit0,
+      critbest, ls->npos, ls->dim);
+
+   fprintf(f, ",\"eigval\":[");
+   for( i = 0; i < nquadexprs; ++i )
+      fprintf(f, "%s%.17g", i > 0 ? "," : "", eigenvalues[i]);
+   fprintf(f, "],\"eigvec\":[");
+   for( i = 0; i < nquadexprs * nquadexprs; ++i )
+      fprintf(f, "%s%.17g", i > 0 ? "," : "", eigenvectors[i]);
+   fprintf(f, "],\"sqrcoef\":[");
+   for( i = 0; i < nquadexprs; ++i )
+   {
+      SCIP_Real sqrcoef;
+      SCIPexprGetQuadraticQuadTerm(qexpr, i, NULL, NULL, &sqrcoef, NULL, NULL, NULL);
+      fprintf(f, "%s%.17g", i > 0 ? "," : "", sqrcoef);
+   }
+   fprintf(f, "],\"quadlin\":[");
+   for( i = 0; i < nquadexprs; ++i )
+   {
+      SCIP_Real lincoef;
+      SCIPexprGetQuadraticQuadTerm(qexpr, i, NULL, &lincoef, NULL, NULL, NULL, NULL);
+      fprintf(f, "%s%.17g", i > 0 ? "," : "", lincoef);
+   }
+   fprintf(f, "],\"bilin\":[");
+   for( i = 0; i < nbilin; ++i )
+   {
+      SCIP_EXPR* e1;
+      SCIP_Real coef;
+      int pos1 = -1;
+      int pos2;
+
+      SCIPexprGetQuadraticBilinTerm(qexpr, i, &e1, NULL, &coef, &pos2, NULL);
+      for( j = 0; j < nquadexprs; ++j )
+      {
+         SCIP_EXPR* ej;
+         SCIPexprGetQuadraticQuadTerm(qexpr, j, &ej, NULL, NULL, NULL, NULL, NULL);
+         if( ej == e1 )
+         {
+            pos1 = j;
+            break;
+         }
+      }
+      fprintf(f, "%s[%d,%d,%.17g]", i > 0 ? "," : "", pos1, pos2, coef);
+   }
+   fprintf(f, "],\"lincoef\":[");
+   for( i = 0; i < nlinexprs; ++i )
+      fprintf(f, "%s%.17g", i > 0 ? "," : "", lincoefs[i]);
+   fprintf(f, "],\"sbar\":[");
+   for( i = 0; i < nquadexprs; ++i )
+   {
+      SCIP_EXPR* expr;
+      SCIPexprGetQuadraticQuadTerm(qexpr, i, &expr, NULL, NULL, NULL, NULL, NULL);
+      fprintf(f, "%s%.17g", i > 0 ? "," : "", SCIPgetSolVal(scip, sol, SCIPgetExprAuxVarNonlinear(expr)));
+   }
+   for( i = 0; i < nlinexprs; ++i )
+      fprintf(f, ",%.17g", SCIPgetSolVal(scip, sol, SCIPgetExprAuxVarNonlinear(linexprs[i])));
+   if( auxvar != NULL )
+      fprintf(f, ",%.17g", SCIPgetSolVal(scip, sol, auxvar));
+   fprintf(f, "],\"rays\":[");
+   for( i = 0; i < rays->nrays; ++i )
+   {
+      fprintf(f, "%s[", i > 0 ? "," : "");
+      for( j = rays->raysbegin[i]; j < rays->raysbegin[i + 1]; ++j )
+         fprintf(f, "%s[%d,%.17g]", j > rays->raysbegin[i] ? "," : "", rays->raysidx[j], rays->rays[j]);
+      fprintf(f, "]");
+   }
+   fprintf(f, "],\"nconsvars\":%d,\"w\":[", nconsvars);
+   for( i = 0; i < rays->nrays; ++i )
+      fprintf(f, "%s%.17g", i > 0 ? "," : "", ls->rawweight[i]);
+   fprintf(f, "],\"lam0\":[");
+   for( i = 0; i < ls->dim; ++i )
+      fprintf(f, "%s%.17g", i > 0 ? "," : "", lambda0[i]);
+   fprintf(f, "],\"lam\":[");
+   for( i = 0; i < ls->dim; ++i )
+      fprintf(f, "%s%.17g", i > 0 ? "," : "", lambdabest[i]);
+   fprintf(f, "],\"alpha0\":[");
+   for( i = 0; i < rays->nrays; ++i )
+      fprintf(f, "%s%.17g", i > 0 ? "," : "", SCIPisInfinity(scip, alpha0[i]) ? -1.0 : alpha0[i]);
+   fprintf(f, "],\"alpha\":[");
+   for( i = 0; i < rays->nrays; ++i )
+      fprintf(f, "%s%.17g", i > 0 ? "," : "", SCIPisInfinity(scip, alphabest[i]) ? -1.0 : alphabest[i]);
+   fprintf(f, "]}\n");
+
+   fclose(f);
+}
+
+/** chooses lambda for the current cut according to nlhdlrdata->setrule (and/or dumps the corner)
+ *
+ *  Rule 1 maximizes the single-cut corner bound min_j w_j alpha_j(lambda) over SCIP's family {C_lambda}
+ *  (w_j = reduced cost of the nonbasic variable of ray j, floored at 1e-6 max_j w_j); rule 2 maximizes the
+ *  Euclidean efficacy of the cut in the space of LP columns.  For dim(lambda) = 2 the search is a grid over the
+ *  half circle centered at SCIP's lambda followed by golden-section refinement; for dim > 2 it is a projected
+ *  (sub)gradient ascent with line searches.  SCIP's lambda is kept unless the criterion improves by the
+ *  relative margin SETRULE_MINGAIN.
+ */
+static
+SCIP_RETCODE selectLambda(
+   SCIP*                 scip,               /**< SCIP data structure */
+   SCIP_NLHDLRDATA*      nlhdlrdata,         /**< nlhdlr data */
+   SCIP_NLHDLREXPRDATA*  nlhdlrexprdata,     /**< nlhdlr expression data */
+   RAYS*                 rays,               /**< rays */
+   SCIP_VAR*             auxvar,             /**< aux var or NULL */
+   SCIP_SOL*             sol,                /**< solution to separate */
+   SCIP_Real             sidefactor,         /**< 1.0 if the violated constraint is q &le; rhs, -1.0 otherwise */
+   SCIP_Bool             iscase4,            /**< whether we are in case 4 */
+   SCIP_Real*            vb,                 /**< array containing v_i^T b */
+   SCIP_Real*            vzlp,               /**< array containing v_i^T zlp_q */
+   SCIP_Real*            wcoefs,             /**< coefficients of w for the qud vars or NULL if w is 0 */
+   SCIP_Real             wzlp,               /**< value of w at zlp */
+   SCIP_Real             kappa,              /**< value of kappa */
+   SCIP_Bool             dosearch,           /**< whether to search (setrule > 0) */
+   SCIP_Bool             dodump,             /**< whether to dump the corner */
+   SCIP_Real*            lambdaout,          /**< buffer (length >= npos + 1) to store the chosen lambda */
+   SCIP_Bool*            changed             /**< pointer to store whether lambdaout differs from SCIP's lambda */
+   )
+{
+   LAMBDASEARCH ls;
+   SCIP_COL** cols;
+   SCIP_ROW** rows;
+   SCIP_Real* lambda0;
+   SCIP_Real* best;
+   SCIP_Real* work;
+   SCIP_Real* dir;
+   SCIP_Real* alpha0;
+   SCIP_Real* alphabest;
+   SCIP_Real crit0;
+   SCIP_Real critbest;
+   SCIP_Real norm;
+   SCIP_Real wmax;
+   int nentries;
+   int npos;
+   int dim;
+   int j;
+   int k;
+
+   *changed = FALSE;
+
+   npos = countPositiveEigenvalues(scip, nlhdlrexprdata, sidefactor);
+   dim = npos + ((iscase4 || kappa > 0.0) ? 1 : 0);
+   if( dim < 1 || rays->nrays == 0 )
+      return SCIP_OKAY;
+   if( dim < 2 && ! dodump )
+      return SCIP_OKAY;
+
+   cols = SCIPgetLPCols(scip);
+   rows = SCIPgetLPRows(scip);
+
+   BMSclearMemory(&ls);
+   ls.nrays = rays->nrays;
+   ls.npos = npos;
+   ls.dim = dim;
+   ls.iscase4 = iscase4;
+   ls.kappa = kappa;
+   ls.wzlp = wzlp;
+   ls.sr = sqrt(sqrt(1.0 + SQR(kappa)));
+   ls.rule = nlhdlrdata->setrule > 0 ? nlhdlrdata->setrule : 1;
+
+   SCIP_CALL( SCIPallocBufferArray(scip, &ls.x0, dim) );
+   SCIP_CALL( SCIPallocBufferArray(scip, &ls.ya, ls.nrays) );
+   SCIP_CALL( SCIPallocBufferArray(scip, &ls.yb, ls.nrays) );
+   SCIP_CALL( SCIPallocBufferArray(scip, &ls.yc, ls.nrays) );
+   SCIP_CALL( SCIPallocBufferArray(scip, &ls.wray, ls.nrays) );
+   SCIP_CALL( SCIPallocBufferArray(scip, &ls.xr, ls.nrays * dim) );
+   SCIP_CALL( SCIPallocBufferArray(scip, &ls.weight, ls.nrays) );
+   SCIP_CALL( SCIPallocBufferArray(scip, &ls.rawweight, ls.nrays) );
+   SCIP_CALL( SCIPallocBufferArray(scip, &ls.alpha, ls.nrays) );
+   SCIP_CALL( SCIPallocBufferArray(scip, &lambda0, dim) );
+   SCIP_CALL( SCIPallocBufferArray(scip, &best, dim) );
+   SCIP_CALL( SCIPallocBufferArray(scip, &work, dim) );
+   SCIP_CALL( SCIPallocBufferArray(scip, &dir, dim) );
+   SCIP_CALL( SCIPallocBufferArray(scip, &alpha0, ls.nrays) );
+   SCIP_CALL( SCIPallocBufferArray(scip, &alphabest, ls.nrays) );
+
+   /* xhat(zlp) and SCIP's lambda */
+   computeLambdaX0(scip, nlhdlrexprdata, sidefactor, vb, vzlp, ls.x0);
+   if( iscase4 )
+      ls.x0[npos] = (wzlp + kappa + sqrt(1.0 + SQR(kappa))) / (2.0 * ls.sr);
+   else if( kappa > 0.0 )
+      ls.x0[npos] = sqrt(kappa);
+   norm = 0.0;
+   for( k = 0; k < dim; ++k )
+      norm += SQR(ls.x0[k]);
+   norm = sqrt(norm);
+   if( norm <= 0.0 )
+      goto TERMINATE;
+   for( k = 0; k < dim; ++k )
+      lambda0[k] = ls.x0[k] / norm;
+
+   /* ray data and reduced costs */
+   wmax = 0.0;
+   for( j = 0; j < ls.nrays; ++j )
+   {
+      int lppos;
+
+      computeLambdaRayData(scip, nlhdlrexprdata, sidefactor, iscase4, &rays->rays[rays->raysbegin[j]],
+         &rays->raysidx[rays->raysbegin[j]], rays->raysbegin[j + 1] - rays->raysbegin[j], vb, vzlp, wcoefs,
+         &ls.ya[j], &ls.yb[j], &ls.yc[j], &ls.xr[j * dim], &ls.wray[j]);
+      if( iscase4 )
+         ls.xr[j * dim + npos] = ls.wray[j] / (2.0 * ls.sr);
+      else if( kappa > 0.0 )
+         ls.xr[j * dim + npos] = 0.0;
+
+      lppos = rays->lpposray[j];
+      if( lppos >= 0 )
+         ls.rawweight[j] = REALABS(SCIPgetColRedcost(scip, cols[lppos]));
+      else
+         ls.rawweight[j] = REALABS(SCIProwGetDualsol(rows[-lppos - 1]));
+      wmax = MAX(wmax, ls.rawweight[j]);
+   }
+   for( j = 0; j < ls.nrays; ++j )
+      ls.weight[j] = MAX(ls.rawweight[j], 1e-6 * MAX(wmax, 1e-9));
+
+   /* structural vectors for the efficacy rule */
+   if( ls.rule == 2 )
+   {
+      int pos;
+
+      nentries = 0;
+      for( j = 0; j < ls.nrays; ++j )
+         nentries += rays->lpposray[j] >= 0 ? 1 : SCIProwGetNLPNonz(rows[-rays->lpposray[j] - 1]);
+      SCIP_CALL( SCIPallocBufferArray(scip, &ls.ubeg, ls.nrays + 1) );
+      SCIP_CALL( SCIPallocBufferArray(scip, &ls.uidx, MAX(nentries, 1)) );
+      SCIP_CALL( SCIPallocBufferArray(scip, &ls.uval, MAX(nentries, 1)) );
+      SCIP_CALL( SCIPallocClearBufferArray(scip, &ls.dense, SCIPgetNLPCols(scip)) );
+      pos = 0;
+      for( j = 0; j < ls.nrays; ++j )
+      {
+         int lppos = rays->lpposray[j];
+
+         ls.ubeg[j] = pos;
+         if( lppos >= 0 )
+         {
+            ls.uidx[pos] = lppos;
