 typedef struct Rays RAYS;
 
+/*
+ * Intersection-cut dump instrumentation (research copy, not part of SCIP).
+ * If the environment variable SCIP_INTERCUT_DUMP names a file, every call of the
+ * quadratic nlhdlr enforcement that reaches generateIntercut writes one JSON line
+ * with the data needed to recompute the cut. Counters of early returns are written
+ * as a final line when the nlhdlr data is freed.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdarg.h>
+
+/* POSIX 2008; declared here because SCIP compiles with -std=c99 */
+extern FILE* open_memstream(char** ptr, size_t* sizeloc);
+
+static FILE* icdfile = NULL;        /* output file (NULL: dumping off) */
+static int icdinit = 0;             /* whether getenv was checked */
+static char* icdbuf = NULL;         /* buffer of current record */
+static size_t icdbufsize = 0;
+static FILE* icdmem = NULL;         /* memstream of current record (NULL: no record open) */
+static const char* icdfail = NULL;  /* failure reason of current attempt */
+static int icdnperray = 0;          /* number of per-ray entries written */
+static long long icdcount[16];      /* counters of enfo outcomes */
+static void* icdmainscip = NULL;    /* main SCIP (subscip depth 0) */
+static const char* icdcountname[16] = {"calls", "skip_branchcandonly", "skip_convex", "skip_off", "skip_lpnotgood",
+   "skip_node", "skip_limit", "skip_noeig", "skip_viol", "skip_rootandsub", "skip_feasible", "attempts",
+   "generated", "cleanup_ok", "added", "highre"};
+
+static
+SCIP_Bool icdActive(void)
+{
+   if( !icdinit )
+   {
+      const char* fn = getenv("SCIP_INTERCUT_DUMP");
+      icdinit = 1;
+      if( fn != NULL && fn[0] != '\0' )
+         icdfile = fopen(fn, "a");
+   }
+   return icdfile != NULL;
+}
+
+static
+void icdPrintf(const char* fmt, ...)
+{
+   va_list ap;
+   if( icdmem == NULL )
+      return;
+   va_start(ap, fmt);
+   vfprintf(icdmem, fmt, ap);
+   va_end(ap);
+}
+
+static
+void icdReal(SCIP_Real x)
+{
+   if( x != x )
+      icdPrintf("NaN");
+   else if( x > 1e300 )
+      icdPrintf("Infinity");
+   else if( x < -1e300 )
+      icdPrintf("-Infinity");
+   else
+      icdPrintf("%.17g", x);
+}
+
+static
+void icdRealArray(const char* key, const SCIP_Real* x, int n)
+{
+   int i;
+   icdPrintf(",\"%s\":[", key);
+   for( i = 0; i < n; ++i )
+   {
+      if( i > 0 )
+         icdPrintf(",");
+      icdReal(x[i]);
+   }
+   icdPrintf("]");
+}
+
+static
+void icdStr(const char* s)
+{
+   icdPrintf("\"");
+   for( ; s != NULL && *s != '\0'; ++s )
+   {
+      if( *s == '"' || *s == '\\' )
+         icdPrintf("\\%c", *s);
+      else if( (unsigned char)*s < 32 )
+         icdPrintf("?");
+      else
+         icdPrintf("%c", *s);
+   }
+   icdPrintf("\"");
+}
+
+static
+void icdBegin(void)
+{
+   if( !icdActive() )
+      return;
+   icdmem = open_memstream(&icdbuf, &icdbufsize);
+   icdfail = NULL;
+   icdnperray = 0;
+   icdPrintf("{\"v\":1");
+}
+
+static
+void icdEnd(void)
+{
+   if( icdmem == NULL )
+      return;
+   if( icdfail != NULL )
+      icdPrintf(",\"fail\":\"%s\"", icdfail);
+   icdPrintf("}\n");
+   fclose(icdmem);
+   icdmem = NULL;
+   fputs(icdbuf, icdfile);
+   fflush(icdfile);
+   free(icdbuf);
+   icdbuf = NULL;
+   icdbufsize = 0;
+}
+
+static
+void icdCounterLine(void)
+{
+   int i;
+   if( !icdActive() )
+      return;
+   fprintf(icdfile, "{\"counters\":{");
+   for( i = 0; i < 16; ++i )
+      fprintf(icdfile, "%s\"%s\":%lld", i > 0 ? "," : "", icdcountname[i], icdcount[i]);
+   fprintf(icdfile, "}}\n");
+   fflush(icdfile);
+}
+
+/** writes the quadratic data, bounds and LP values of the constraint variables */
+static
+void icdQuadData(
+   SCIP*                 scip,
+   SCIP_NLHDLREXPRDATA*  nlhdlrexprdata,
+   SCIP_EXPR*            expr,
+   SCIP_CONS*            cons,
+   SCIP_SOL*             sol
+   )
+{
+   SCIP_EXPR* qexpr = nlhdlrexprdata->qexpr;
+   SCIP_EXPR** linexprs;
+   SCIP_Real* lincoefs;
+   SCIP_Real* eigenvalues;
+   SCIP_Real* eigenvectors;
+   SCIP_Real constant;
+   SCIP_VAR* auxvar;
+   int nlinexprs;
+   int nquadexprs;
+   int nbilinexprs;
+   int i;
+   int j;
+
+   if( icdmem == NULL )
+      return;
+
+   SCIPexprGetQuadraticData(qexpr, &constant, &nlinexprs, &linexprs, &lincoefs, &nquadexprs, &nbilinexprs,
+      &eigenvalues, &eigenvectors);
+   auxvar = (nlhdlrexprdata->cons != cons) ? SCIPgetExprAuxVarNonlinear(expr) : NULL;
+
+   icdPrintf(",\"auxvar\":");
+   if( auxvar != NULL )
+      icdStr(SCIPvarGetName(auxvar));
+   else
+      icdPrintf("null");
+   icdPrintf(",\"nquad\":%d,\"nlin\":%d,\"constant\":", nquadexprs, nlinexprs);
+   icdReal(constant);
+   if( nlhdlrexprdata->cons != NULL )
+   {
+      icdPrintf(",\"lhs\":");
+      icdReal(SCIPgetLhsNonlinear(nlhdlrexprdata->cons));
+      icdPrintf(",\"rhs\":");
+      icdReal(SCIPgetRhsNonlinear(nlhdlrexprdata->cons));
+   }
+   icdPrintf(",\"vars\":[");
+   for( i = 0; i < nquadexprs; ++i )
+   {
+      SCIP_EXPR* e;
+      SCIPexprGetQuadraticQuadTerm(qexpr, i, &e, NULL, NULL, NULL, NULL, NULL);
+      if( i > 0 )
+         icdPrintf(",");
+      icdStr(SCIPvarGetName(SCIPgetExprAuxVarNonlinear(e)));
+   }
+   for( i = 0; i < nlinexprs; ++i )
+   {
+      icdPrintf(",");
+      icdStr(SCIPvarGetName(SCIPgetExprAuxVarNonlinear(linexprs[i])));
+   }
+   if( auxvar != NULL )
+   {
+      icdPrintf(",");
+      icdStr(SCIPvarGetName(auxvar));
+   }
+   icdPrintf("]");
+
+   /* lincoef and sqrcoef of quadratic exprs */
+   icdPrintf(",\"qlin\":[");
+   for( i = 0; i < nquadexprs; ++i )
+   {
+      SCIP_Real lc;
+      SCIPexprGetQuadraticQuadTerm(qexpr, i, NULL, &lc, NULL, NULL, NULL, NULL);
+      if( i > 0 )
+         icdPrintf(",");
+      icdReal(lc);
+   }
+   icdPrintf("],\"qsqr\":[");
+   for( i = 0; i < nquadexprs; ++i )
+   {
+      SCIP_Real sc;
+      SCIPexprGetQuadraticQuadTerm(qexpr, i, NULL, NULL, &sc, NULL, NULL, NULL);
+      if( i > 0 )
+         icdPrintf(",");
+      icdReal(sc);
+   }
+   icdPrintf("],\"bilin\":[");
+   for( i = 0; i < nbilinexprs; ++i )
+   {
+      SCIP_EXPR* e1;
+      SCIP_EXPR* e2;
+      SCIP_Real bc;
+      int pos2;
+      int pos1 = -1;
+      SCIPexprGetQuadraticBilinTerm(qexpr, i, &e1, &e2, &bc, &pos2, NULL);
+      for( j = 0; j < nquadexprs; ++j )
+      {
+         SCIP_EXPR* e;
+         SCIPexprGetQuadraticQuadTerm(qexpr, j, &e, NULL, NULL, NULL, NULL, NULL);
+         if( e == e1 )
+         {
+            pos1 = j;
+            break;
+         }
+      }
+      icdPrintf("%s[%d,%d,", i > 0 ? "," : "", pos1, pos2);
+      icdReal(bc);
+      icdPrintf("]");
+   }
+   icdPrintf("]");
+   icdRealArray("lincoefs", lincoefs, nlinexprs);
+   if( eigenvalues != NULL )
+   {
+      icdRealArray("eigval", eigenvalues, nquadexprs);
+      icdRealArray("eigvec", eigenvectors, nquadexprs * nquadexprs);
+   }
+
+   /* LP values and local bounds of [quad vars, lin vars, aux var] */
+   {
+      int nv = nquadexprs + nlinexprs + (auxvar != NULL ? 1 : 0);
+      SCIP_VAR** vs;
+      if( SCIPallocBufferArray(scip, &vs, nv) != SCIP_OKAY )
+         return;
+      for( i = 0; i < nquadexprs; ++i )
+      {
+         SCIP_EXPR* e;
+         SCIPexprGetQuadraticQuadTerm(qexpr, i, &e, NULL, NULL, NULL, NULL, NULL);
+         vs[i] = SCIPgetExprAuxVarNonlinear(e);
+      }
+      for( i = 0; i < nlinexprs; ++i )
+         vs[nquadexprs + i] = SCIPgetExprAuxVarNonlinear(linexprs[i]);
+      if( auxvar != NULL )
+         vs[nv - 1] = auxvar;
+      icdPrintf(",\"zlp\":[");
+      for( i = 0; i < nv; ++i )
+      {
+         if( i > 0 )
+            icdPrintf(",");
+         icdReal(SCIPgetSolVal(scip, sol, vs[i]));
+      }
+      icdPrintf("],\"lb\":[");
+      for( i = 0; i < nv; ++i )
+      {
+         if( i > 0 )
+            icdPrintf(",");
+         icdReal(SCIPvarGetLbLocal(vs[i]));
+      }
+      icdPrintf("],\"ub\":[");
+      for( i = 0; i < nv; ++i )
+      {
+         if( i > 0 )
+            icdPrintf(",");
+         icdReal(SCIPvarGetUbLocal(vs[i]));
+      }
+      icdPrintf("],\"integral\":[");
+      for( i = 0; i < nv; ++i )
+         icdPrintf("%s%d", i > 0 ? "," : "", SCIPvarIsIntegral(vs[i]) ? 1 : 0);
+      icdPrintf("]");
+      SCIPfreeBufferArray(scip, &vs);
+   }
+}
+
+/** writes the rays (dense over the constraint variables) with basis status and objective rates */
+static
+void icdRays(
+   SCIP*                 scip,
+   RAYS*                 rays,
+   int                   nv
+   )
+{
+   SCIP_COL** cols;
+   SCIP_ROW** rows;
+   int r;
+   int k;
+
+   if( icdmem == NULL )
+      return;
+   cols = SCIPgetLPCols(scip);
+   rows = SCIPgetLPRows(scip);
+   icdPrintf(",\"nrays\":%d,\"raylppos\":[", rays->nrays);
+   for( r = 0; r < rays->nrays; ++r )
+      icdPrintf("%s%d", r > 0 ? "," : "", rays->lpposray[r]);
+   icdPrintf("],\"raystat\":[");
+   for( r = 0; r < rays->nrays; ++r )
+   {
+      int lppos = rays->lpposray[r];
+      int st = lppos >= 0 ? (int)SCIPcolGetBasisStatus(cols[lppos]) : (int)SCIProwGetBasisStatus(rows[-lppos - 1]);
+      icdPrintf("%s%d", r > 0 ? "," : "", st);
+   }
+   icdPrintf("],\"rayrate\":[");
+   for( r = 0; r < rays->nrays; ++r )
+   {
+      int lppos = rays->lpposray[r];
+      if( r > 0 )
+         icdPrintf(",");
+      icdReal(lppos >= 0 ? SCIPgetColRedcost(scip, cols[lppos]) : SCIProwGetDualsol(rows[-lppos - 1]));
+   }
+   icdPrintf("],\"raywidth\":[");
+   for( r = 0; r < rays->nrays; ++r )
+   {
+      int lppos = rays->lpposray[r];
+      if( r > 0 )
+         icdPrintf(",");
+      if( lppos >= 0 )
+         icdReal(SCIPcolGetUb(cols[lppos]) - SCIPcolGetLb(cols[lppos]));
+      else
+         icdReal(SCIProwGetRhs(rows[-lppos - 1]) - SCIProwGetLhs(rows[-lppos - 1]));
+   }
+   icdPrintf("],\"rayname\":[");
+   for( r = 0; r < rays->nrays; ++r )
+   {
+      int lppos = rays->lpposray[r];
+      if( r > 0 )
+         icdPrintf(",");
+      icdStr(lppos >= 0 ? SCIPvarGetName(SCIPcolGetVar(cols[lppos])) : SCIProwGetName(rows[-lppos - 1]));
+   }
+   /* sparse rays: for each ray a list of [index into constraint variables, value] */
+   icdPrintf("],\"nv\":%d,\"rays\":[", nv);
+   for( r = 0; r < rays->nrays; ++r )
+   {
+      icdPrintf("%s[", r > 0 ? "," : "");
+      for( k = rays->raysbegin[r]; k < rays->raysbegin[r + 1]; ++k )
+      {
+         icdPrintf("%s[%d,", k > rays->raysbegin[r] ? "," : "", rays->raysidx[k]);
+         icdReal(rays->rays[k]);
+         icdPrintf("]");
+      }
+      icdPrintf("]");
+   }
+   icdPrintf("]");
+}
+
+/** writes a rowprep */
+static
+void icdRowprep(
+   const char*           key,
+   SCIP_ROWPREP*         rowprep
+   )
+{
+   int i;
+   if( icdmem == NULL )
+      return;
+   icdPrintf(",\"%s\":{\"side\":", key);
+   icdReal(SCIProwprepGetSide(rowprep));
+   icdPrintf(",\"sidetype\":%d,\"vars\":[", (int)SCIProwprepGetSidetype(rowprep));
+   for( i = 0; i < SCIProwprepGetNVars(rowprep); ++i )
+   {
+      if( i > 0 )
+         icdPrintf(",");
+      icdStr(SCIPvarGetName(SCIProwprepGetVars(rowprep)[i]));
+   }
+   icdPrintf("]");
+   icdRealArray("coefs", SCIProwprepGetCoefs(rowprep), SCIProwprepGetNVars(rowprep));
+   icdPrintf("}");
+}
