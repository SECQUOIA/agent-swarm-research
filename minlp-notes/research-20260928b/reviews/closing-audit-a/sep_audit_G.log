n=5: G=15 vector=(1, 11, 15, 15, 15) sum_i N_i >= 57, ceil(avg)=12; det ratio (2G+1)/3 = 31/3; rand ratio = 119/15; 2^(n+2)/(3n) = 128/15; |P(empty)| = 8410
