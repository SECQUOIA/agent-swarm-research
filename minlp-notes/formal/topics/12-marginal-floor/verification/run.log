ExactCounts.exact_box_counts (n : ℕ) :
  IsLeast {p | ExactCounts.HasIntegerLift n p} n ∧
    IsLeast {p | ExactCounts.HasBinaryLift n p} (ExactCounts.binaryCount n) ∧
      IsLeast {p | ExactCounts.HasRationalIntegerLift n p} n ∧
        IsLeast {p | ExactCounts.HasRationalBinaryLift n p} (ExactCounts.binaryCount n) ∧
          ↑(ExactCounts.binaryCount n) = ⌈↑n * Real.logb 2 3⌉ ∧
            ∃ rows, ExactCounts.Admissible (ExactCounts.rationalPolyhedron rows) (ExactCounts.IntegerCodes n)
