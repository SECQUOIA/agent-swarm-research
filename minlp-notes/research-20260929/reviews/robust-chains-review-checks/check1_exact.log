   W + c1 (x-y) + g_inf - [g (d/2+1)(d/2-q)^2 + s^2 (b/2 + ev/4 - g d/8)] = 0
   c1 at (0.6,0.3,0.05): -19/192 ; c1^2/a = 0.0150657719017094
