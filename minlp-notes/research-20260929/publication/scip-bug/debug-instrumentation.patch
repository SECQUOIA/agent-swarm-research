+/* LOCAL PATCH (scip-bug track): check intervals against the debug solution */
+#include <execinfo.h>
+#include <stdlib.h>
+static int scipbugExprCheck(
+   SCIP*                 scip,
+   SCIP_EXPR*            expr,
+   SCIP_INTERVAL         interval,
+   const char*           what,
+   const char*           who
+   )
+{
+#ifdef WITH_DEBUG_SOLUTION
+   SCIP_Bool inside = FALSE;
+   SCIP_SOL* debugsol = NULL;
+   SCIP_Real v;
+   if( getenv("SCIPBUG_EXPR") == NULL || !SCIPdebugIsMainscip(scip) || SCIPgetStage(scip) != SCIP_STAGE_SOLVING )
+      return 0;
+   if( SCIPdebugSolIsValidInSubtree(scip, &inside) != SCIP_OKAY || !inside )
+      return 0;
+   if( SCIPdebugGetSol(scip, &debugsol) != SCIP_OKAY || debugsol == NULL )
+      return 0;
+   if( SCIPevalExpr(scip, expr, debugsol, 0) != SCIP_OKAY )
+      return 0;
+   v = SCIPexprGetEvalValue(expr);
+   if( getenv("SCIPBUG_EXPRVERBOSE") != NULL )
+   {
+      printf("SCIPBUG EXPRCHK: %s by <%s>: [%.17g,%.17g] debug value %.17g (probing %u depth %d) expr ", what, who, interval.inf, interval.sup, v, SCIPinProbing(scip), SCIPgetDepth(scip));
+      fflush(stdout);
+      (void) SCIPprintExpr(scip, expr, NULL);
+      printf("\n");
+      fflush(stdout);
+   }
+   if( v == SCIP_INVALID ) /*lint !e777*/
+      return 0;
+   if( SCIPintervalIsEmpty(SCIP_INTERVAL_INFINITY, interval) || SCIPisFeasLT(scip, v, interval.inf) || SCIPisFeasGT(scip, v, interval.sup) )
+   {
+      void* buf[40];
+      int n;
+      printf("SCIPBUG EXPR: %s by <%s>: interval [%.17g,%.17g] excludes debug value %.17g (activity [%.17g,%.17g], probing %u, depth %d) of expr ",
+         what, who, interval.inf, interval.sup, v, SCIPexprGetActivity(expr).inf, SCIPexprGetActivity(expr).sup,
+         SCIPinProbing(scip), SCIPgetDepth(scip));
+      fflush(stdout);
+      (void) SCIPprintExpr(scip, expr, NULL);
+      printf("\n");
+      fflush(stdout);
+      if( getenv("SCIPBUG_BT") != NULL )
+      {
+         n = backtrace(buf, 40);
+         backtrace_symbols_fd(buf, n, 1);
+      }
+      return 1;
+   }
+#endif
+   return 0;
