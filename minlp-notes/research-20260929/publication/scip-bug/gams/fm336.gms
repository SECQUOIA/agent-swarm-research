* fm336: minimized fuzz reproducer min/fm336_v1010.cip, written by export_models.write_gms
Variables objvar;
Variables s0,p0,q0,w0,s1,p1,q1,w1,s2,p2;
Variables q2,w2;
Binary Variables b0,b1,b2;
s0.lo = 0.7;
s0.up = 1;
p0.lo = 0.343;
p0.up = 1;
q0.lo = 0;
q0.up = 1;
w0.lo = 0;
w0.up = 1;
s1.lo = 0.85;
s1.up = 1;
p1.fx = 0.614125;
q1.lo = 0;
q1.up = 1;
w1.lo = 0;
w1.up = 1;
s2.lo = 0.6;
s2.up = 1;
p2.lo = 0.216;
p2.up = 1;
q2.lo = 0;
q2.up = 0.5;
w2.lo = 0;
w2.up = 1;
Equations objdef;
Equations cube0,speed0,flow0,pow0,speed1,flow1,pow1,cube2,speed2,flow2;
Equations pow2,demand;
objdef.. objvar =e= +5*w0 +0.2*b1 +1*w1 +0.1*b2 +2*w2;
cube0.. -1*p0 +1*power(s0,3) =e= 0;
speed0.. +1*s0 -0.3*b0 =l= 0.7;
flow0.. +1*q0 -3*s0 -0.3*b0 =l= -2.1;
pow0.. +1*w0 -1*p0 -1*b0 =g= -1;
speed1.. +1*s1 -0.15*b1 =l= 0.85;
flow1.. +1*q1 -2*s1 -0.3*b1 =l= -1.7;
pow1.. +1*w1 -1*p1 -1*b1 =g= -1;
cube2.. -1*p2 +1*power(s2,3) =e= 0;
speed2.. +1*s2 -0.4*b2 =l= 0.6;
flow2.. +1*q2 -3*s2 -0.3*b2 =l= -1.8;
pow2.. +1*w2 -1*p2 -1*b2 =g= -1;
demand.. +1*q0 +1*q1 +1*q2 =g= 0.5;
Model m / all /;
m.optcr = 0; m.optca = 0;
option minlp = scip, threads = 1, reslim = 600;
$if set scipopt m.optfile = 1;
Solve m using minlp minimizing objvar;
display objvar.l, m.objest, m.modelstat, m.solvestat;
