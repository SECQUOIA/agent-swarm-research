* fm318: minimized fuzz reproducer min/fm318_master.cip, written by export_models.write_gms
Variables objvar;
Variables s0,p0,q0,w0,s1,p1,q1,w1;
Binary Variables b0,b1;
s0.lo = 0.7;
s0.up = 1;
p0.lo = 0.343;
p0.up = 1;
q0.lo = 0;
q0.up = 0.8;
w0.lo = 0;
w0.up = 1;
b1.lo = 1;
s1.lo = 0.7;
s1.up = 1;
p1.lo = 0.343;
p1.up = 1;
q1.lo = 0;
q1.up = 0.8;
w1.lo = 0;
w1.up = 1;
Equations objdef;
Equations cube0,speed0,flow0,pow0,cube1,flow1,pow1,demand;
objdef.. objvar =e= +3*w0 +2*w1;
cube0.. -1*p0 +1*power(s0,3) =e= 0;
speed0.. +1*s0 -0.3*b0 =l= 0.7;
flow0.. +1*q0 -1*s0 -0.1*b0 =l= -0.7;
pow0.. +1*w0 -1*p0 -1*b0 =g= -1;
cube1.. -1*p1 +1*power(s1,3) =e= 0;
flow1.. +1*q1 -2*s1 -0.1*b1 =l= -1.4;
pow1.. +1*w1 -1*p1 -1*b1 =g= -1;
demand.. +1*q0 +1*q1 =g= 0.5;
Model m / all /;
m.optcr = 0; m.optca = 0;
option minlp = scip, threads = 1, reslim = 600;
$if set scipopt m.optfile = 1;
Solve m using minlp minimizing objvar;
display objvar.l, m.objest, m.modelstat, m.solvestat;
