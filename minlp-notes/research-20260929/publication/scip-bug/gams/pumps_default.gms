* pumps_default: exported by export_models.py (see README in this folder)
Variables objvar;
Variables s0,p0,q0,w0,s1,p1,q1,w1,s2,p2;
Variables q2,w2,s3,p3,q3,w3;
Binary Variables b0,b1,b2,b3;
s0.fx = 0.85;
p0.fx = 0.614125;
q0.lo = 0;
q0.up = 0.8;
w0.lo = 0;
w0.up = 1;
s1.lo = 0.7;
s1.up = 1;
p1.lo = 0.343;
p1.up = 1;
q1.lo = 0;
q1.up = 0.5;
w1.lo = 0;
w1.up = 1;
s2.fx = 0.6;
p2.fx = 0.216;
q2.lo = 0;
q2.up = 0.8;
w2.lo = 0;
w2.up = 1;
s3.lo = 0.7;
s3.up = 1;
p3.lo = 0.343;
p3.up = 1;
q3.lo = 0;
q3.up = 0.5;
w3.fx = 0.512;
Equations objdef;
Equations flow0,pow0,cube1,speed1,flow1,pow1,flow2,pow2,cube3,speed3;
Equations flow3,demand;
objdef.. objvar =e= +0.1*b0 +1*w0 +2*w1 +0.1*b2 +5*w2 +0.1*b3 +1*w3;
flow0.. +1*q0 -2*s0 -0.3*b0 =l= -1.7;
pow0.. +1*w0 -1*p0 -1*b0 =g= -1;
cube1.. -1*p1 +1*power(s1,3) =e= 0;
speed1.. +1*s1 -0.3*b1 =l= 0.7;
flow1.. +1*q1 -2*s1 -0.3*b1 =l= -1.4;
pow1.. +1*w1 -1*p1 -1*b1 =g= -1;
flow2.. +1*q2 -2*s2 -0.3*b2 =l= -1.2;
pow2.. +1*w2 -1*p2 -1*b2 =g= -1;
cube3.. -1*p3 +1*power(s3,3) =e= 0;
speed3.. +1*s3 -0.3*b3 =l= 0.7;
flow3.. +1*q3 -1*s3 -0.2*b3 =l= -0.7;
demand.. +1*q0 +1*q1 +1*q2 +1*q3 =g= 0.3;
Model m / all /;
m.optcr = 0; m.optca = 0;
option minlp = scip, threads = 1, reslim = 600;
$if set scipopt m.optfile = 1;
Solve m using minlp minimizing objvar;
display objvar.l, m.objest, m.modelstat, m.solvestat;
