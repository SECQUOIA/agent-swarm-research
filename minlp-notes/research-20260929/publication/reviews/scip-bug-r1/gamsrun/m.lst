C o m p i l a t i o n


   1  * Minimal reproducer (same model as minimal/tiny2.cip)
   2  *   min 0.2 b - 2.4 s + p  s.t.  p = s^3,  s - 0.3 b <= 0.7,
   3  *   b binary, 0.7 <= s <= 1, 0.343 <= p <= 1.
   4  * True optimum -1.337 at b = 0, s = 0.7, p = 0.343 (exactly feasible).
   5  Variables obj, s, p;
   6  Binary Variable b;
   7  s.lo = 0.7; s.up = 1; p.lo = 0.343; p.up = 1;
   8  * start at a feasible point with b = 1 (GAMS would otherwise pass the lower bounds,
   9  * which happen to be the optimum, as starting point)
  10  b.l = 1; s.l = 1; p.l = 1;
  11  Equations defobj, cube, speed;
  12  defobj.. obj =e= 0.2*b - 2.4*s + p;
  13  cube..   -p + power(s,3) =e= 0;
  14  speed..  s - 0.3*b =l= 0.7;
  15  Model m / all /;
  16  m.optcr = 0; m.optca = 0;
  17  option minlp = scip, threads = 1;
  18  m.optfile = 1;
  19  Solve m using minlp minimizing obj;
  20  display obj.l, b.l, s.l, p.l, m.objest, m.modelstat, m.solvestat;


