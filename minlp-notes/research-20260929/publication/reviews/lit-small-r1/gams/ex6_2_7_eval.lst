C o m p i l a t i o n


   1  *****************************************************************
   2  *** Chapter 6
   3  *** Test Problem 7
   4  ***
   5  *** Ethylene Glycol - Lauryl Alcohol - Nitromethane
   6  ***  -- Gibbs energy minimization(UNIQUAC)
   7  *****************************************************************
   8   
   9  SETS
  10      i     components                /1*3/
  11      k     phases                    /1*3/
  12      alias(i,j);
  13   
  14  *****************************************************************
  15  * P = pressure (atm)
  16  * T = temperature (K)
  17  * liqphase(k) = is phase k a liquid phase?
  18  * ntot(i) = number of moles of component i in feed
  19  * alpha(i,j) = binary interaction parameter (symmetric)
  20  * z, q(i), r(i), qp(i), zr(i), zrm, zb(i), za, psi(i) = pure component
  21  *   and calculated parameters
  22  * tau(i,j) = binary interaction parameter (nonsymmetric)
  23   
  24  PARAMETERS
  25  P, T, liqphase(k), ntot(i),
  26  minval,
  27  z, q(i), r(i), qp(i), zr(i), zrm, zb(i), za, psi(i), tau(i,j), bina(i,j);
  28   
  29  P = 1.0;
  30  T = 295.0;
  31   
  32  liqphase('1') = 1; liqphase('2') = 1; liqphase('3') = 1;
  33   
  34  ntot('1') = 0.4;
  35  ntot('2') = 0.1;
  36  ntot('3') = 0.5;
  37   
  38  z = 10.0;
  39   
  40  q('1') = 2.2480;
  41  q('2') = 7.3720;
  42  q('3') = 1.8680;
  43   
  44  qp('1') = 2.2480;
  45  qp('2') = 7.3720;
  46  qp('3') = 1.8680;
  47   
  48  r('1') = 2.4088;
  49  r('2') = 8.8495;
  50  r('3') = 2.0086;
  51   
  52  bina('1','1') = 0.0; bina('1','2') = 247.2; bina('1','3') = 54.701;
  53  bina('2','1') = 69.69; bina('2','2') = 0.0; bina('2','3') = 305.52;
  54  bina('3','1') = 467.88; bina('3','2') = 133.19; bina('3','3') = 0.0;
  55   
  56  tau(i,j) = EXP(-bina(i,j)/T);
  57  zr(i) = (z*q(i)/2.0 - 1.0)/r(i);
  58  minval = 100.0;
  59  LOOP(i, IF( (zr(i) LT minval), minval = zr(i)));
  60  zrm = minval;
  61  zb(i) = SUM(j$(ord(j) NE ord(i)), zr(j)-zrm);
  62  za = zrm + SUM(i,zr(i)-zrm);
  63  psi(i) = qp(i) + r(i)*za;
  64   
  65   
  66  ***************************************************************************
  67  * gfe = Gibbs free energy
  68  * n(i,k) = number of moles of component i in phase k
  69   
  70  VARIABLES gfe, n(i,k);
  71   
  72  ***************************************************************************
  73  * obj = objective function
  74  * molesum(i) = material balance on component i
  75   
  76  EQUATIONS
  77      obj
  78      molesum(i);
  79   
  80   
  81  obj.. gfe =e= SUM(k$liqphase(k),  SUM(i, n(i,k)*(z*q(i)*LOG(q(i))/2.0-zr(i)*r(i)*LOG(r(i))))
  82                      +SUM(i, za*r(i)*n(i,k))*LOG(SUM(j,r(j)*n(j,k)))
  83                      +SUM(i, zb(i)*r(i)*n(i,k)*LOG(n(i,k)))
  84                      +SUM(i, -zb(i)*r(i)*n(i,k)*LOG(SUM(j, r(j)*n(j,k))))
  85                      +SUM(i, (z/2.0)*q(i)*n(i,k)*LOG(n(i,k)))
  86                      +SUM(i, -(z/2.0)*q(i)*n(i,k)*LOG(SUM(j, q(j)*n(j,k))))
  87                      +SUM(i, qp(i)*n(i,k))*LOG(SUM(j,qp(j)*n(j,k)))
  88                      +SUM(i, qp(i)*n(i,k)*LOG(n(i,k)))
  89                      +SUM(i, -qp(i)*n(i,k)*LOG(SUM(j, qp(j)*tau(j,i)*n(j,k)))) )
  90  +SUM(k$liqphase(k),  SUM(i, -psi(i)*n(i,k)*LOG(n(i,k))));
  91   
  92   
  93  molesum(i).. SUM(k, n(i,k)) =e= ntot(i);
  94   
  95  MODEL gmin / all /;
  96   
  97  n.lo(i,k) = 0.0000001; n.up(i,k) = ntot(i);
  98  n.l('1','1') = 0.00880; n.l('1','2') = 0.33595; n.l('1','3') = 0.05525;
  99  n.l('2','1') = 0.00065; n.l('2','2') = 0.00193; n.l('2','3') = 0.09742;
 100  n.l('3','1') = 0.30803; n.l('3','2') = 0.14700; n.l('3','3') = 0.04497;
 101   
