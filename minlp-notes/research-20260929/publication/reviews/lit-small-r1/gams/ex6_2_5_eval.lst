C o m p i l a t i o n


   1  *****************************************************************
   2  *** Chapter 6
   3  *** Test Problem 5
   4  ***
   5  *** SBA - DSBE - Water -- Gibbs energy minimization(UNIQUAC)
   6  *****************************************************************
   7   
   8  SETS
   9      i     components                /1*3/
  10      k     phases                    /1*3/
  11      alias(i,j);
  12   
  13  *****************************************************************
  14  * P = pressure (atm)
  15  * T = temperature (K)
  16  * liqphase(k) = is phase k a liquid phase?
  17  * ntot(i) = number of moles of component i in feed
  18  * gform(i,k) = Gibbs energy of formation of component i in phase k
  19  * z, q(i), r(i), qp(i), zr(i), zrm, zb(i), za, psi(i) = pure component
  20  *   and calculated parameters
  21  * tau(i,j) = binary interaction parameter (nonsymmetric)
  22   
  23  PARAMETERS
  24  gc, P, T, liqphase(k), gform(i,k), ntot(i),
  25  minval,
  26  z, q(i), r(i), qp(i), zr(i), zrm, zb(i), za, psi(i), tau(i,j), bina(i,j);
  27   
  28  gc = 1.98721;
  29  P = 1.16996;
  30  *T = 363.19909;
  31  T = 721.67659;
  32   
  33  liqphase('1') = 1; liqphase('2') = 1; liqphase('3') = 0;
  34   
  35  gform('1','1') = -0.3658348; gform('1','2') = -0.3658348; gform('1','3') = 0.0;
  36  gform('2','1') = -0.9825555; gform('2','2') = -0.9825555; gform('2','3') = 0.0;
  37  gform('3','1') = -0.3663657; gform('3','2') = -0.3663657; gform('3','3') = 0.0;
  38   
  39  ntot('1') = 40.30707;
  40  ntot('2') = 5.14979;
  41  ntot('3') = 54.54314;
  42   
  43  z = 10.0;
  44   
  45  q('1') = 3.6640;
  46  q('2') = 5.1680;
  47  q('3') = 1.4000;
  48   
  49  qp('1') = 4.0643;
  50  qp('2') = 5.7409;
  51  qp('3') = 1.6741;
  52   
  53  r('1') = 3.9235;
  54  r('2') = 6.0909;
  55  r('3') = 0.9200;
  56   
  57  bina('1','1') = 0.0; bina('1','2') = -193.141; bina('1','3') = 424.025;
  58  bina('2','1') = 415.855; bina('2','2') = 0.0; bina('2','3') = 315.312;
  59  bina('3','1') = 103.810; bina('3','2') = 3922.5; bina('3','3') = 0.0;
  60   
  61  tau(i,j) = EXP(-bina(i,j)/T);
  62  zr(i) = (z*q(i)/2.0 - 1.0)/r(i);
  63  minval = 100.0;
  64  LOOP(i, IF( (zr(i) LT minval), minval = zr(i)));
  65  zrm = minval;
  66  zb(i) = SUM(j$(ord(j) NE ord(i)), zr(j)-zrm);
  67  za = zrm + SUM(i,zr(i)-zrm);
  68  *psi(i) = qp(i) + r(i)*za;
  69  psi(i) = qp(i) + r(i)*(zr(i)+zb(i));
  70   
  71  DISPLAY psi, zr, zb, za, tau;
  72   
  73  ***************************************************************************
  74  * gfe = Gibbs free energy
  75  * n(i,k) = number of moles of component i in phase k
  76   
  77  VARIABLES gfe, n(i,k);
  78   
  79  ***************************************************************************
  80  * obj = objective function
  81  * molesum(i) = material balance on component i
  82   
  83  EQUATIONS
  84      obj
  85      molesum(i);
  86   
  87   
  88  obj.. gfe =e= SUM(k$liqphase(k), SUM(i, n(i,k)*gform(i,k)))
  89  +SUM(k$(liqphase(k) eq 0), SUM(i, n(i,k)*(LOG(n(i,k)/SUM(j,n(j,k)))+LOG(P))))
  90  +SUM(k$liqphase(k),  SUM(i, n(i,k)*(z*q(i)*LOG(q(i))/2.0-zr(i)*r(i)*LOG(r(i))))
  91                      +SUM(i, za*r(i)*n(i,k))*LOG(SUM(j,r(j)*n(j,k)))
  92                      +SUM(i, zb(i)*r(i)*n(i,k)*LOG(n(i,k)))
  93                      +SUM(i, -zb(i)*r(i)*n(i,k)*LOG(SUM(j, r(j)*n(j,k))))
  94                      +SUM(i, (z/2.0)*q(i)*n(i,k)*LOG(n(i,k)))
  95                      +SUM(i, -(z/2.0)*q(i)*n(i,k)*LOG(SUM(j, q(j)*n(j,k))))
  96                      +SUM(i, qp(i)*n(i,k))*LOG(SUM(j,qp(j)*n(j,k)))
  97                      +SUM(i, qp(i)*n(i,k)*LOG(n(i,k)))
  98                      +SUM(i, -qp(i)*n(i,k)*LOG(SUM(j, qp(j)*tau(j,i)*n(j,k)))) )
  99  +SUM(k$liqphase(k),  SUM(i, -psi(i)*n(i,k)*LOG(n(i,k))));
 100   
 101  molesum(i).. SUM(k, n(i,k)) =e= ntot(i);
 102   
 103  MODEL gmin / all /;
 104   
 105  n.lo(i,k) = 0.0000001; n.up(i,k) = ntot(i);
 106  n.l('1','1') = 31.459; n.l('1','2') = 0.901998;
 107  n.l('2','1') = 3.10348; n.l('2','2') = 0.0000096;
 108  n.l('3','1') = 26.1669; n.l('3','2') = 15.0141;
