C o m p i l a t i o n


   1  * Own transcription of Coleman-Liao problem 5 / CUTEst DTOC5 with coefficient c on h*y^2
   2  * (c=1: source model; c=4: MINLPLib/QPLIB 8585 variant).  y(1)=1, h=1/N.
   5  Set t /1*100/; Set tt(t); tt(t) = yes$(ord(t) < card(t));
   6  Scalar h; h = 1/100;
   7  Variables x(t), y(t), f;
   8  Equations obj, dyn(t);
   9  obj.. f =e= h*sum(tt, sqr(y(tt)) + sqr(x(tt)));
  10  dyn(tt(t)).. y(t+1) =e= y(t) + 1*h*sqr(y(t)) - h*x(t);
  11  y.fx('1') = 1; x.l(t) = 1; y.l(t) = 1;
  12  x.fx(t)$(not tt(t)) = 0;
  13  Model m /all/;
  14  option nlp=ipopt;
  15  Solve m using nlp minimizing f;
  16  file res /'dtoc5_100_1_ipopt.txt'/; put res; put 'N=100 c=1 solver=ipopt obj=' f.l:22:12 ' ms=' m.modelstat:3:0 ' ss=' m.solvestat:3:0 /; putclose;


