# latexmk settings for the paper and its supplement: PDF via pdflatex,
# output in build/. Plain `latexmk` builds both documents. Each reads the
# other's .aux file (xr-hyper), so use `make`, which runs latexmk twice
# (development/build.md).
$pdf_mode = 1;
$out_dir = 'build';
@default_files = ('main.tex', 'supplement.tex');
