# Test of the setup recipe of Section S7.1 and artifact/README.md (Build phase r4, after G7-09)
# Run on 2026-10-05 from 00:47:28 to 00:50:59 (-04:00), under 'taskset -c 0,1' (CPU affinity 0,1).
# ARCHIVE was a /tmp stand-in of the archive: the research tree as in the repository and the
# final paper tree of this version (sources, tables, artifact files and the rebuilt index;
# without build/). Apart from the ARCHIVE line, the run differs from the printed recipe only in
# output: pip ran with -q, two lines list the installed versions, and the output of
# make_tables.py is cut to its last line. This log replaces the G7 test of 00:22-00:27, which
# used a stand-in with the round-3 sections.
# Driver: /tmp/r4/recipe/recipe-test.sh (not archived). Omitted below: the trace of the venv
# activation script and pip notices.

## Recipe as run, then the short checks
ARCHIVE=/tmp/r4/archive          # read only
WORK=$(mktemp -d /tmp/minlp-work-XXXXXX)   # disposable: rm -rf "$WORK"
cp -r "$ARCHIVE"/. "$WORK"/ && cd "$WORK"
export HOME="$WORK/home" XDG_CACHE_HOME="$WORK/workspace/local-home"
export TMPDIR="$WORK/tmp" PIP_NO_CACHE_DIR=1 PYTHONDONTWRITEBYTECODE=1
R="$WORK/research-20260929"; P="$WORK/paper-open-minlplib"
export MINLP_REPO_ROOT="$WORK" EG_AUDIT_R="$R" MINLPLIB_OSIL_ROOT="$WORK/osil"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
mkdir -p "$TMPDIR" "$MINLPLIB_OSIL_ROOT" "$HOME/.cache/minlplib/minlplib"
cp "$R"/publication/minlplib-status/pages/models/osil/*.osil \
   "$MINLPLIB_OSIL_ROOT"
ln -s "$MINLPLIB_OSIL_ROOT" "$HOME/.cache/minlplib/minlplib/osil"
python3 "$P/artifact/check_claims.py" --repo-root "$WORK"
python3 -m venv "$WORK/venv" && . "$WORK/venv/bin/activate"
python -m pip install -q -r "$R/publication/reproduction/requirements.txt"
python -m pip list | grep -i -E "mpmath|numpy|scipy|sympy|pyscipopt|cvxpy|clarabel|highspy"
python "$P/artifact/prepare_paper_inputs.py"
cd /tmp && python "$P/data/make_tables.py" | tail -n 1
echo "WORK=$WORK"; echo "HOME=$HOME"; ls -la "$HOME/.cache/minlplib/minlplib/"
python "$P/artifact/run_short_checks.py" --repo-root "$WORK" --logs "$WORK/short-logs"
echo "short-checks exit: $?"
du -sh "$WORK/home" "$WORK/tmp" "$WORK/venv"; find "$WORK/home" -maxdepth 4 | head -30

